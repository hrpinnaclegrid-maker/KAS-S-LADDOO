        <tr>
          <td>1 Laddu (35g)</td>
          <td><strong>158 kcal</strong></td>
          <td>4.8g</td>
          <td>8.6g</td>
          <td>3.1g</td>
          <td>Natural Arabian Dates (Zero Refined Sugar)</td>
        </tr>
      </tbody>
    </table>
    
    <div class="pricing-bar">
      Price: ₹520 &nbsp;&nbsp;|&nbsp;&nbsp; Packaging: 400g (Box of 10-12 laddus) &nbsp;&nbsp;|&nbsp;&nbsp; Production: Available in Fresh Kitchen Batches
